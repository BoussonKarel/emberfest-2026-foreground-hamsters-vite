{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types", "chrome-scripts"],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "vite-hamster-wacking/tests/*": ["./tests/*"],
      "vite-hamster-wacking/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types",
      "chrome"
    ]
  }
}
